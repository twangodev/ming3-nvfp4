# Python defaults adapted from:
# https://github.com/github/gitignore/blob/main/Python.gitignore

# Bytecode and native extensions
__pycache__/
*.py[codz]
*$py.class
*.so

# Build and package outputs
build/
dist/
.eggs/
*.egg-info/
*.egg
wheels/

# Virtual environments and local configuration
.venv/
venv/
env/
ENV/
.env
.envrc
.pypirc

# Test reports and tool caches
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
.cache/
.ipynb_checkpoints/

# Editor settings
.idea/

# Generated project data and release workspaces
/artifacts/
/data/
/releases/
/evals/
/runs/
/outputs/

# Model weights and runtime logs
*.safetensors
*.pt
*.pth
*.bin
*.log

# Keep uv.lock and .python-version versioned for reproducibility.
