# Replace these absolute paths before running containers.
MING_MODEL_DIR=/absolute/path/to/models
MING_WORK_DIR=/absolute/path/to/ming-work
MING_HF_HUB_DIR=/absolute/path/to/huggingface/hub
MING_UID=1000
MING_GID=1000
MING_GPU=0
MING_PORT=8091
MING_CHECKPOINT=/models/tiny-nvfp4
MING_PROFILE=/opt/ming/evaluation/profiles/tiny.yaml
